# Supabase – Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Veřejný "anon" / "publishable" klíč (smí být v prohlížeči, data chrání RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Připojení k databázi pro serverovou část (Project Settings → Database → Connection string)
# Na Vercelu použijte "Transaction pooler" (port 6543). Heslo NIKDY necommitujte.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:HESLO@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# Pouze pro jednorázový skript `npm run create-admin` na vašem počítači.
# Service role klíč NIKDY nenastavujte jako NEXT_PUBLIC_ ani na Vercelu.
SUPABASE_SERVICE_ROLE_KEY=
