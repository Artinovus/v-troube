# Připojovací řetězec k PostgreSQL (14+). Heslo NIKDY necommitujte.
# Neon / Vercel Postgres: použijte "pooled" řetězec (…-pooler…, sslmode=require).
DATABASE_URL=postgresql://uzivatel:HESLO@host:5432/ztrouby?sslmode=require

# Volitelně: přímé (nepoolované) připojení pro migrace a skript create-admin.
# DATABASE_URL_UNPOOLED=postgresql://uzivatel:HESLO@host:5432/ztrouby?sslmode=require

# Volitelně: maximální počet spojení z jedné instance (výchozí 5).
# DATABASE_POOL_MAX=5

# Jen pro provoz přes čisté HTTP bez HTTPS (např. v domácí síti). Jinak nenastavujte.
# INSECURE_COOKIES=1
